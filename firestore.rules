rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /events/{eventId} {
      allow read, write: if true;
    }
    match /attendanceRecords/{recordId} {
      allow read, write: if true;
    }
  }
}
