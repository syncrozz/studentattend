{
  "entities": {
    "staff": {
      "title": "Staff",
      "description": "Master directory of staff members",
      "properties": {
        "id": { "type": "string", "description": "Unique staff ID (e.g. ST001)" },
        "name": { "type": "string", "description": "Full name" },
        "department": { "type": "string", "description": "Department name" },
        "position": { "type": "string", "description": "Job position" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "avatarUrl": { "type": "string", "description": "Avatar URL" },
        "status": { "type": "string", "description": "Status ACTIVE or INACTIVE" }
      },
      "required": ["id", "name", "department", "position", "email", "status"]
    },
    "events": {
      "title": "Events",
      "description": "Event and meeting contexts",
      "properties": {
        "id": { "type": "string", "description": "Event ID (e.g. E001)" },
        "name": { "type": "string", "description": "Event name" },
        "category": { "type": "string", "description": "Category" },
        "date": { "type": "string", "description": "Event date" },
        "startTime": { "type": "string", "description": "Start time" },
        "endTime": { "type": "string", "description": "End time" },
        "location": { "type": "string", "description": "Location" },
        "status": { "type": "string", "description": "Status OPEN, CLOSED, or ARCHIVED" },
        "description": { "type": "string", "description": "Description" },
        "targetCount": { "type": "number", "description": "Target headcount" },
