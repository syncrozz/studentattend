        "eventId": { "type": "string", "description": "Event ID" },
        "eventName": { "type": "string", "description": "Event Name" },
        "staffId": { "type": "string", "description": "Staff ID" },
        "staffName": { "type": "string", "description": "Staff Name" },
        "staffDepartment": { "type": "string", "description": "Staff Department" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "formattedTime": { "type": "string", "description": "Formatted time display" },
        "method": { "type": "string", "description": "Scan method" }
      },
      "required": ["id", "eventId", "eventName", "staffId", "staffName", "staffDepartment", "timestamp", "formattedTime", "method"]
